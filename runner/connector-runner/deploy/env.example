# connector-runner — INERT env reference TEMPLATE (PR #202). PLACEHOLDERS ONLY; no real region/account/secret/KMS/DB
# values. These are the env vars the future ECS/Fargate task definition sets; `deploy-config.ts` validates their SHAPE.
# Reference fields hold NAMES/ALIASES/ARNs/env-var-NAMES — never a secret VALUE. RISK-007 OPEN; runner disabled.

# Pinned non-secret literals (doc 46 §12)
RUNNER_RUNTIME_TARGET=ecs-fargate
RUNNER_INGESTION_MODEL=secrets-manager-task-read
RUNNER_APP_ENV=staging

# References only (replace at deploy time with real staging values — NEVER commit real ones)
CONNECTOR_VAULT_AWS_KMS_REGION=REPLACE_WITH_REGION
CONNECTOR_VAULT_KMS_KEY_ID=REPLACE_WITH_KMS_KEY_REF       # e.g. alias/<name> or a KMS key ARN — never key material
CONNECTOR_VAULT_SECRET_REF=REPLACE_WITH_SECRET_REF        # a Secrets Manager secret NAME/ARN — never the secret value
CONNECTOR_RUNNER_DB_URL_REF=REPLACE_WITH_DB_REF           # the ENV-VAR NAME the runner reads the DB url from — never a URL

# ID_CADDIE_CONNECTOR_RUNNER_ENABLED is intentionally UNSET — the runner is disabled/fail-closed in this skeleton.
# There is NO production-ready enable flag in this PR; enabling requires the RISK-007 closure work (see deploy/README.md).
